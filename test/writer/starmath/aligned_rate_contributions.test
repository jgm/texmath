\begin{aligned}
r_{j,\pm}^{0}
&=\underbrace{A_j\exp\!\left(-\frac{E_j}{R_{\mathrm u}T}\right)}_{k_j(T):\ \text{Arrhenius coefficient}}
\times\underbrace{(\text{gas factor})_{j,\pm}}_{\text{local hydrogen/steam}}
\times\underbrace{(\text{solid factor})_{j,\pm}}_{\text{inventory, presence and access}},\\
r_j^0&=r_{j,+}^{0}-r_{j,-}^{0}.
\end{aligned}
